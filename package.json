{
  "name": "agent-bootstrap",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-bootstrap": "bin/agent-bootstrap.ts"
  },
  "scripts": {
    "lo": "bun run src/local-orchestrator/cli.ts",
    "concierge": "bun run spike/local-orchestrator/concierge.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src test",
    "typecheck": "bun check -p tsconfig.json",
    "verify": "bun fmt --check && bun lint && bun typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.67.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.45.0"
  }
}
